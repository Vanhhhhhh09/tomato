extends layout

block content
  section.hero-top.is-hidden#hero-top
    span.eyebrow
      span.eyebrow-mark &#9670;
      | Ứng dụng thị giác máy tính
    h1.hero-title Phát hiện và chẩn đoán bệnh trên cây cà chua và dưa chuột
    p.hero-desc
      | Chọn loại cây/bộ phận, tải ảnh lên, hệ thống sẽ dùng mô hình YOLO để
      | nhận diện loại bệnh và khoanh vùng chính xác khu vực bị ảnh hưởng.

  section.wizard-stage#wizard-stage
    .wizard-stage-bg
      .wizard-stage-bg-half.bg-tomato
      .wizard-stage-bg-half.bg-cucumber
    .wizard-stage-overlay
    .wizard-stage-content
      .wizard-step#step-plant
        h2.wizard-stage-title Chọn loại cây trồng
        .wizard-divider
          span.wizard-divider-line
          span.wizard-divider-icon 🌿
          span.wizard-divider-line
        .wizard-choices
          button.wizard-card(type="button" data-plant="tomato")
            span.wizard-icon-ring.icon-tomato
            span.wizard-label Cà chua
          span.wizard-divider-v
          button.wizard-card(type="button" data-plant="cucumber")
            span.wizard-icon-ring.icon-cucumber
            span.wizard-label Dưa chuột

  //- Màn hình tải ảnh + 2 panel phụ - chỉ hiện sau khi đã chọn xong ở trên
  section.grid-3col.is-hidden#step-upload-grid
    .panel.panel-upload
      button.wizard-back(type="button" data-back-dynamic="true") ← Quay lại

      .wizard-summary
        span.wizard-summary-icon#summary-icon
        span.wizard-summary-text#summary-text

      form.upload-form(action="/detect" method="POST" enctype="multipart/form-data")
        input(type="hidden" name="plant_type" id="plant-type-input")

        label.dropzone(for="image-input" id="dropzone")
          input#image-input.dropzone-input(type="file" name="image" accept="image/png, image/jpeg" required)
          .dropzone-icon
            svg(width="26" height="26" viewBox="0 0 40 40" fill="none")
              path(d="M20 26V10M20 10L13 17M20 10L27 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round")
              path(d="M8 29V31C8 32.6569 9.34315 34 11 34H29C30.6569 34 32 32.6569 32 31V29" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round")
          p.dropzone-title Kéo thả ảnh vào đây
          p.dropzone-sub-line hoặc
          p.dropzone-sub Bấm để chọn file .JPG, .PNG, tối đa 10MB.

          .dropzone-preview#preview-wrap
            img#preview-img(alt="Ảnh xem trước")

          p.upload-error#upload-error

        button.btn-submit#submit-btn(type="submit")
          span.btn-submit-text Phát hiện bệnh

        p.form-note
          span.dot &#9670;
          |  Kết quả chỉ mang tính hỗ trợ tham khảo, không thay thế chẩn đoán chuyên gia

    .panel
      h2.panel-title Hướng dẫn chụp ảnh tốt

      ul.tip-list
        li.tip-row
          span.tip-icon.icon-sun ☀
          | Chụp rõ nét, đủ ánh sáng
        li.tip-row
          span.tip-icon.icon-leaf &#127807;
          | Nền đơn giản, không bị rối
        li.tip-row
          span.tip-icon.icon-cam &#128247;
          | Chụp cận cảnh vùng cần kiểm tra
        li.tip-row
          span.tip-icon.icon-drop &#128167;
          | Tránh chụp khi bề mặt bị ướt
        li.tip-row
          span.tip-icon.icon-leaf &#127807;
          | Ưu tiên chụp 1 lá hoặc 1 đoạn thân/ảnh

      .callout
        span.callout-icon &#128161;
        div
          p.callout-title Mẹo nhỏ
          p.callout-desc Kết quả sẽ chính xác hơn khi ảnh chụp cận, rõ vùng bị ảnh hưởng.

    .panel
      h2.panel-title Hệ thống sử dụng
      p.panel-desc
        | AgriScan ứng dụng mô hình YOLOv8 được huấn luyện riêng cho từng loại cây/bộ phận
        | để phát hiện các bệnh phổ biến trên lá và thân.

      ul.disease-list
        li
          span.check &#10003;
          | Bệnh đốm sương (Late Blight)
        li
          span.check &#10003;
          | Bệnh đốm lá (Septoria Leaf Spot)
        li
          span.check &#10003;
          | Bệnh xoăn vàng lá (Yellow Leaf Curl Virus)
        li
          span.check &#10003;
          | Bệnh đốm bạc lá (Early Blight)
        li
          span.check &#10003;
          | Bệnh đốm vi khuẩn (Bacterial Spot)
        li
          span.check &#10003;
          | Và các bệnh khác trên lá, thân cây cà chua và dưa chuột