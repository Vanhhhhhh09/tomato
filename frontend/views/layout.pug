doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title || 'AgriScan - Phát hiện bệnh lá cà chua'}
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
    block head

  body
    header.site-header
      .header-inner
        a.brand(href="/")
          img.brand-logo(src="/img/logo.png" alt="Học viện Nông nghiệp Việt Nam")
          .brand-text
            span.brand-name AgriScan
            span.brand-sub Học viện Nông nghiệp Việt Nam

        nav.main-nav
          a.nav-link.is-active(href="/") Phát hiện
          a.nav-link(href="/history") Lịch sử
          a.nav-link(href="/about") Giới thiệu

    main.site-main
      block content

    footer.site-footer
      .footer-columns
        .footer-col
          span.footer-brand AgriScan
          p.footer-text Ứng dụng trí tuệ nhân tạo trong nông nghiệp, hỗ trợ phát hiện và khoanh vùng bệnh trên lá cà chua chính xác và nhanh chóng.

        .footer-col
          span.footer-heading Liên hệ
          ul.footer-list
            li Học viện Nông nghiệp Việt Nam
            li Trâu Quỳ, Gia Lâm, Hà Nội
            li cskh@vnua.edu.vn

        .footer-col
          span.footer-heading Giới thiệu
          p.footer-text AgriScan là đề tài khóa luận tốt nghiệp ứng dụng mô hình YOLO trong phát hiện bệnh lá cà chua.

        .footer-col
          span.footer-heading Kết nối
          .footer-social
            a.social-icon(href="#" target="_blank" rel="noopener" aria-label="Github")
              svg(width="18" height="18" viewBox="0 0 24 24" fill="currentColor")
                path(d="M12 0C5.37 0 0 5.4 0 12.06c0 5.32 3.44 9.83 8.2 11.42.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.62-4.04-1.62-.55-1.4-1.34-1.78-1.34-1.78-1.1-.75.08-.73.08-.73 1.21.09 1.85 1.25 1.85 1.25 1.08 1.86 2.83 1.32 3.52 1.01.11-.79.42-1.32.77-1.63-2.67-.31-5.47-1.35-5.47-6c0-1.32.47-2.41 1.24-3.26-.12-.31-.54-1.56.12-3.24 0 0 1.01-.33 3.3 1.24a11.4 11.4 0 0 1 6 0c2.29-1.57 3.3-1.24 3.3-1.24.66 1.68.24 2.93.12 3.24.77.85 1.24 1.94 1.24 3.26 0 4.66-2.81 5.68-5.49 5.99.43.38.81 1.12.81 2.26 0 1.63-.02 2.94-.02 3.34 0 .32.22.7.83.58C20.56 21.88 24 17.37 24 12.06 24 5.4 18.63 0 12 0Z")

      .footer-bottom
        span Khóa luận tốt nghiệp &middot; Phát hiện và khoanh vùng bệnh lá cà chua bằng YOLO
        span.footer-diamond &#9670;
        span 2026

    script(src="/js/upload.js")
    block scripts